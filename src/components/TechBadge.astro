---
import { techMeta } from "../data/tech";

interface Props {
  tech: string;
}

const { tech } = Astro.props;

const meta = techMeta[tech];
// The mark is used as a mask, so only its silhouette matters — the brand
// color the CDN paints it in is discarded and the ink token takes over.
const iconUrl = meta?.slug ? `https://cdn.simpleicons.org/${meta.slug}` : null;
---

<span
  class="inline-flex items-center gap-2 border border-rule px-3 py-1.5 text-[11px] font-medium text-ink-faint"
>
  {
    iconUrl ? (
      <span class="tech-icon" style={`--icon: url('${iconUrl}')`} aria-hidden="true" />
    ) : (
      <span class="tech-fallback" aria-hidden="true">
        {meta?.fallback ?? tech.slice(0, 1)}
      </span>
    )
  }
  <span>{tech}</span>
</span>
