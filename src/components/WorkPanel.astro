---
interface Props {
  /** Must match the id of the tab that controls this panel. */
  id: string;
  title: string;
  description: string;
  hidden?: boolean;
}

const { id, title, description, hidden = false } = Astro.props;
---

<section
  id={`work-panel-${id}`}
  class="work-panel"
  role="tabpanel"
  aria-labelledby={`work-tab-${id}`}
  data-work-panel={id}
  hidden={hidden}
>
  <div class="scroll-animate">
    <h3
      class="text-[clamp(20px,4.2vw,28px)] font-medium leading-[1.25] tracking-[-0.01em] text-ink"
    >
      {title}
    </h3>
    <p class="mt-3 max-w-[62ch] text-[13px] leading-[1.7] text-ink-faint">
      {description}
    </p>
  </div>

  <slot />
</section>
