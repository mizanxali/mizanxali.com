---
import { workTabs } from "../data/site";
---

{/* The bar carries the pane's top padding so that when it sticks, its opaque
    fill covers everything scrolling underneath. */}
<div class="sticky top-0 z-20 -mx-2 bg-bg px-2 pt-8 pb-7 lg:pt-10">
  <div
    class="flex flex-wrap gap-2 border-b border-rule pb-5"
    role="tablist"
    aria-label="Work sections"
  >
    {
      workTabs.map((tab, i) => (
        <button
          type="button"
          id={`work-tab-${tab.id}`}
          class="work-tab"
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`work-panel-${tab.id}`}
          tabindex={i === 0 ? 0 : -1}
          data-work-tab={tab.id}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
</div>
