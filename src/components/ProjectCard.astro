---
import type { Project } from "../types";
import ArrowUpRight from "./icons/ArrowUpRight.astro";
import TechBadge from "./TechBadge.astro";

interface Props {
  project: Project;
  /** Position in the grid, used to stagger the reveal transition. */
  index: number;
  /** Shows an arrow next to the project name. */
  showArrow?: boolean;
}

const { project, index, showArrow = false } = Astro.props;
---

<article
  class="group scroll-animate overflow-hidden border border-white/8 bg-neutral-950/80 transition-all duration-500 hover:border-white/16 hover:bg-neutral-900/80"
  style={`transition-delay: ${index * 50}ms`}
>
  <div class="relative aspect-[16/9] overflow-hidden border-b border-white/8 bg-neutral-900">
    {
      project.image ? (
        <img
          src={project.image}
          alt={project.name}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover object-top opacity-80 transition-all duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center bg-[linear-gradient(135deg,#101010_0%,#171717_50%,#0a0a0a_100%)]">
          <div class="flex h-14 w-14 items-center justify-center border border-white/12 text-xl font-medium text-neutral-200">
            &lt;/&gt;
          </div>
        </div>
      )
    }
  </div>
  <div class="p-5">
    <div class="flex items-center justify-between gap-4">
      <h4
        class="text-base font-semibold text-neutral-100 transition-colors group-hover:text-white"
      >
        {project.name}
      </h4>
      {
        showArrow && (
          <ArrowUpRight class="h-3.5 w-3.5 shrink-0 text-neutral-600 transition-colors group-hover:text-neutral-300" />
        )
      }
    </div>
    <p
      class="mt-2 text-sm leading-relaxed text-neutral-500 transition-colors group-hover:text-neutral-400"
    >
      {project.description}
    </p>

    <div class="mt-5 border-t border-white/8 pt-4">
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-600">Links</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          project.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-white/10 px-3 py-1.5 text-[11px] font-medium text-neutral-300 transition-all duration-300 hover:border-white/20 hover:bg-white/4 hover:text-white"
            >
              <span>{link.label}</span>
              <ArrowUpRight class="h-3 w-3 text-neutral-500 transition-colors group-hover:text-neutral-300" />
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-4 border-t border-white/8 pt-4">
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-neutral-600">Stack</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {project.tech.map((tech) => <TechBadge tech={tech} />)}
      </div>
    </div>
  </div>
</article>
