---
import type { Project } from "../types";
import ArrowUpRight from "./icons/ArrowUpRight.astro";
import TechBadge from "./TechBadge.astro";

interface Props {
  project: Project;
  /** Position in the grid, used to stagger the reveal transition. */
  index: number;
  /** Shows an arrow next to the project name. */
  showArrow?: boolean;
}

const { project, index, showArrow = false } = Astro.props;
---

<article
  class="group cell cell-interactive scroll-animate"
  style={`transition-delay: ${index * 50}ms`}
>
  <div class="relative aspect-[16/9] overflow-hidden border-b border-rule bg-panel">
    {
      project.image ? (
        <img
          src={project.image}
          alt={project.name}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="flex h-14 w-14 items-center justify-center border border-rule text-[15px] text-ink-faint">
            &lt;/&gt;
          </div>
        </div>
      )
    }
  </div>
  <div class="p-6">
    <div class="flex items-center justify-between gap-4">
      <h4 class="text-[16px] font-semibold tracking-[-0.01em] text-ink">
        {project.name}
      </h4>
      {
        showArrow && (
          <ArrowUpRight class="h-3.5 w-3.5 shrink-0 text-ink-ghost transition-colors duration-100 group-hover:text-ink" />
        )
      }
    </div>
    <p class="mt-2.5 max-w-[42ch] text-[13px] leading-[1.7] text-ink-faint">
      {project.description}
    </p>

    <div class="mt-6 border-t border-rule pt-4">
      <p class="label">Links</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          project.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-rule px-3 py-1.5 text-[11px] font-medium text-ink-faint transition-colors duration-100 hover:border-ink hover:bg-ink hover:text-bg"
            >
              <span>{link.label}</span>
              <ArrowUpRight class="h-3 w-3" />
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-4 border-t border-rule pt-4">
      <p class="label">Stack</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {project.tech.map((tech) => <TechBadge tech={tech} />)}
      </div>
    </div>
  </div>
</article>
