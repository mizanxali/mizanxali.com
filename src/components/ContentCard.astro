---
import type { ContentItem } from "../types";
import PlaylistIcon from "./icons/PlaylistIcon.astro";

interface Props {
  item: ContentItem;
  /** Position in the grid, used to stagger the reveal transition. */
  index: number;
}

const { item, index } = Astro.props;
---

<div class="cell scroll-animate" style={`transition-delay: ${index * 50}ms`}>
  <div class="aspect-video border-b border-rule bg-panel">
    {
      item.type === "blog" ? (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group block h-full w-full overflow-hidden"
        >
          <img
            src={item.image}
            alt=""
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </a>
      ) : item.placeholder === "playlist" ? (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-full w-full items-center justify-center px-8 text-center transition-colors duration-100 hover:bg-paper-2"
        >
          <div class="flex flex-col items-center">
            <div class="border border-rule p-5">
              <PlaylistIcon class="h-10 w-10 text-ink-faint" />
            </div>
            <p class="label mt-5">Playlist</p>
            <p class="mt-2 text-[13px] text-ink-faint">Open the full Huddle01 video library</p>
          </div>
        </a>
      ) : (
        <iframe
          src={item.embedUrl}
          title={item.name}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
          class="h-full w-full"
        />
      )
    }
  </div>
  <div class="p-6">
    <h4 class="text-[16px] font-semibold tracking-[-0.01em] text-ink">{item.name}</h4>
    <p class="mt-2.5 max-w-[42ch] text-[13px] leading-[1.7] text-ink-faint">{item.description}</p>
  </div>
</div>
