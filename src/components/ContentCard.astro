---
import type { ContentItem } from "../types";
import PlaylistIcon from "./icons/PlaylistIcon.astro";

interface Props {
  item: ContentItem;
  /** Position in the grid, used to stagger the reveal transition. */
  index: number;
}

const { item, index } = Astro.props;
---

<div
  class="scroll-animate overflow-hidden border border-white/8 bg-neutral-950/80"
  style={`transition-delay: ${index * 50}ms`}
>
  <div class="aspect-video border-b border-white/8">
    {
      item.type === "blog" ? (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group block h-full w-full overflow-hidden bg-neutral-900"
        >
          <img
            src={item.image}
            alt=""
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </a>
      ) : item.placeholder === "playlist" ? (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-full w-full items-center justify-center bg-[linear-gradient(135deg,#111111_0%,#171717_45%,#0a0a0a_100%)] px-8 text-center transition-colors duration-300 hover:bg-neutral-900"
        >
          <div class="flex flex-col items-center">
            <div class="border border-white/12 p-5">
              <PlaylistIcon class="h-10 w-10 text-neutral-200" />
            </div>
            <p class="mt-5 text-[10px] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              Playlist
            </p>
            <p class="mt-2 text-sm text-neutral-300">Open the full Huddle01 video library</p>
          </div>
        </a>
      ) : (
        <iframe
          src={item.embedUrl}
          title={item.name}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
          class="h-full w-full"
        />
      )
    }
  </div>
  <div class="p-5">
    <h4 class="text-base font-semibold text-neutral-100">{item.name}</h4>
    <p class="mt-2 text-sm leading-relaxed text-neutral-500">{item.description}</p>
  </div>
</div>
