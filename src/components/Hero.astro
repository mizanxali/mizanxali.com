---
import { site, socialLinks } from "../data/site";
---

<section class="animate-fade-in pt-8 lg:pt-0">
  <h1 class="mt-4 text-5xl font-bold tracking-tight leading-none md:text-7xl">
    Mizan Ali<span
      class="inline-block w-[3px] h-[0.85em] bg-neutral-50 ml-1 align-middle animate-blink"></span>
  </h1>
  <p class="mt-6 max-w-xl text-base leading-relaxed text-neutral-300 font-light md:text-lg">
    I am a fullstack product engineer, building consumer apps across web3 and AI.<br />
    Over the last 5 years, I have worked at the intersection of
    <span class="hero-highlight hero-highlight-frontend">complex frontend engineering</span>,
    <span class="hero-highlight hero-highlight-realtime">realtime systems</span>,
    <span class="hero-highlight hero-highlight-onchain">onchain interactions</span>,
    <span class="hero-highlight hero-highlight-ai">AI products</span>, and
    <span class="hero-highlight hero-highlight-offline">offline-first mesh networking</span>.<br />I also enjoy writing developer documentation and creating technical video content.
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a
      href={site.resumeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="border border-white/10 px-5 py-2.5 text-sm font-medium text-neutral-300 transition-all duration-300 hover:border-white/20 hover:text-neutral-50"
      >Resume</a
    >
  </div>
  <div class="mt-6 flex flex-wrap gap-4">
    {
      socialLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 text-sm text-neutral-400 transition-colors duration-300 hover:text-white"
        >
          <img
            src={`https://api.iconify.design/simple-icons/${link.icon}.svg?color=white`}
            alt=""
            class="h-3.5 w-3.5 opacity-60 transition-opacity duration-300 group-hover:opacity-100"
          />
          {link.label}
        </a>
      ))
    }
  </div>
</section>
