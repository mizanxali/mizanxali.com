---
import { site, socialLinks } from "../data/site";
---

<section class="animate-fade-in pt-8 lg:pt-0">
  <h1
    class="text-[clamp(36px,4.6vw,60px)] font-semibold lowercase leading-[1.02] tracking-[-0.02em] text-ink"
  >
    Mizan Ali<span class="caret animate-blink"></span>
  </h1>
  <p class="mt-8 max-w-xl text-[14px] leading-[1.7] text-ink-faint text-pretty">
    I am a fullstack product engineer, with a strong frontend focus.<br />
    Over the last 4 years, I have worked at the intersection of
    <span class="em">complex frontend engineering</span>,
    <span class="em">realtime systems</span>, and
    <span class="em">onchain interactions</span>.<br />I love building consumer apps in the web3
    space. I also enjoy writing developer documentation and creating technical video content.
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a href={site.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn">Resume</a>
  </div>
  <div class="mt-6 flex flex-wrap gap-5">
    {
      socialLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13px] text-ink-faint transition-colors duration-100 hover:text-accent"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</section>
