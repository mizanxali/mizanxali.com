---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Sidebar from "../components/Sidebar.astro";
import WorkPanel from "../components/WorkPanel.astro";
import WorkTabs from "../components/WorkTabs.astro";
import { contentItems } from "../data/content";
import { huddle01Projects } from "../data/huddle01Projects";
import { personalProjects } from "../data/personalProjects";
import { site } from "../data/site";

const gridClass = "mt-8 cell-grid";
---

<BaseLayout title={site.title} description={site.description}>
  <div class="min-h-screen lg:h-screen">
    <div class="lg:grid lg:h-screen lg:grid-cols-2">
      <Sidebar />

      <main
        id="content-pane"
        class="px-6 pb-8 lg:h-screen lg:overflow-y-auto lg:px-10 lg:pb-10"
      >
        <section id="work" class="scroll-mt-24">
          <div class="max-w-4xl">
            <WorkTabs />

            <WorkPanel
              id="huddle01"
              title="Things shipped at Huddle01"
              description="Lead Product Engineer, Jan 2023 - Mar 2026. Built core products across web3 and webRTC tech stacks using TypeScript."
            >
              <div class={gridClass}>
                {
                  huddle01Projects.map((project, i) => (
                    <ProjectCard project={project} index={i} />
                  ))
                }
              </div>
            </WorkPanel>

            <WorkPanel
              id="projects"
              title="Side Projects"
              description="Experiments across AI, consumer mobile apps, developer tooling, prediction markets, desktop software, and games."
              hidden
            >
              <div class={gridClass}>
                {
                  personalProjects.map((project, i) => (
                    <ProjectCard project={project} index={i} showArrow />
                  ))
                }
              </div>

              <p class="scroll-animate mt-6 text-[13px] leading-[1.7] text-ink-faint">
                + more on <a
                  href={site.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link">GitHub</a
                >
              </p>
            </WorkPanel>

            <WorkPanel
              id="content"
              title="Content"
              description="Blogs, workshops, walkthroughs, and product-focused video content."
              hidden
            >
              <div class={gridClass}>
                {contentItems.map((item, i) => <ContentCard item={item} index={i} />)}
              </div>
            </WorkPanel>
          </div>
        </section>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  import "../scripts/main";
</script>
