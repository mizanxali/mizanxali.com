---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Sidebar from "../components/Sidebar.astro";
import WorkPanel from "../components/WorkPanel.astro";
import WorkTabs from "../components/WorkTabs.astro";
import { contentItems } from "../data/content";
import { work } from "../data/work";
import { personalProjects } from "../data/personalProjects";
import { site } from "../data/site";

const gridClass = "mt-6 grid grid-cols-1 gap-6 xl:grid-cols-2";
---

<BaseLayout title={site.title} description={site.description}>
  <div class="min-h-screen lg:h-screen">
    <div class="lg:grid lg:h-screen lg:grid-cols-2">
      <Sidebar />

      <main id="content-pane" class="px-6 py-8 lg:h-screen lg:overflow-y-auto lg:px-10 lg:py-10">
        <section id="work" class="scroll-mt-24">
          <div class="max-w-4xl">
            <WorkTabs />

            <WorkPanel
              id="work"
              title="Work"
              description="Things I've shipped at the companies I've worked at."
            >
              {
                work.map((job) => (
                  <div class="mt-12 first:mt-8">
                    <div class="scroll-animate">
                      <h4 class="text-xl font-semibold tracking-tight">{job.company}</h4>
                      <p class="mt-1 text-sm font-light text-neutral-400">
                        {job.role}, {job.period}
                        {job.description && <><br />{job.description}</>}
                      </p>
                    </div>
                    <div class={gridClass}>
                      {job.projects.map((project, i) => (
                        <ProjectCard project={project} index={i} />
                      ))}
                    </div>
                  </div>
                ))
              }
            </WorkPanel>

            <WorkPanel
              id="projects"
              title="Side Projects"
              description="Experiments across AI, consumer mobile apps, developer tooling, prediction markets, desktop software, and games."
              hidden
            >
              <div class={gridClass}>
                {
                  personalProjects.map((project, i) => (
                    <ProjectCard project={project} index={i} showArrow />
                  ))
                }
              </div>

              <p class="mt-5 text-sm font-light text-neutral-500 scroll-animate">
                + more on <a
                  href={site.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-neutral-300 underline decoration-neutral-700 underline-offset-4 transition-all duration-300 hover:text-white hover:decoration-neutral-400"
                  >GitHub</a
                >
              </p>
            </WorkPanel>

            <WorkPanel
              id="content"
              title="Content"
              description="Blogs, workshops, walkthroughs, and product-focused video content."
              hidden
            >
              <div class={gridClass}>
                {contentItems.map((item, i) => <ContentCard item={item} index={i} />)}
              </div>
            </WorkPanel>
          </div>
        </section>
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  import "../scripts/main";
</script>
